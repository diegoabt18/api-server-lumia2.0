# =============================================================================
# Variables de entorno — copiar según entorno:
#   Desarrollo:  cp .env.example .env.development
#   Producción:  cp .env.example .env.production
#
# Al ejecutar npm run dev se carga automáticamente .env.development
# (NODE_ENV=development por defecto). También se lee .env si existe.
# =============================================================================

NODE_ENV=development
APP_NAME=lumia-api
APP_URL=https://api.tu-dominio.com
FRONTEND_URL=https://tu-dominio.com
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# --- MongoDB (4 bases separadas — misma convención que lumia) ---
# En Docker local, todas apuntan al mismo host pero el código fuerza el nombre lógico:
# identity_db, catalog_db, sales_db, production_db
MONGO_AUTH_URI=mongodb://app_user:change_me@mongo:27017/?authSource=admin
MONGO_CATALOG_URI=mongodb://app_user:change_me@mongo:27017/?authSource=admin
MONGO_SALES_URI=mongodb://app_user:change_me@mongo:27017/?authSource=admin
MONGO_PRODUCTION_URI=mongodb://app_user:change_me@mongo:27017/?authSource=admin

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true

# --- JWT (CAMBIAR EN PRODUCCIÓN) ---
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# --- Cookies (cross-subdomain: api.tu-dominio.com ↔ tu-dominio.com) ---
COOKIE_DOMAIN=.tu-dominio.com
COOKIE_ACCESS_NAME=lumia_access
COOKIE_REFRESH_NAME=lumia_refresh
COOKIE_SECURE=true

# --- CORS ---
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# --- Rate limit ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# --- Store ---
ORDER_NUMBER_PREFIX=ORD
STORE_BESTSELLER_TOP_N=8
STORE_POPULAR_MIN_UNITS=3

# --- Auth ---
AUTH_LOCAL_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: cifrado de secretos 2FA (32+ chars). Si no se define, usa JWT_SECRET.
TWO_FACTOR_ENCRYPTION_KEY=

# --- MercadoPago (fase futura) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Órdenes impagas (horas) ---
ORDER_PAYMENT_TTL_HOURS=24
ORDER_MANUAL_PAYMENT_TTL_HOURS=72

# --- Seeds ---
DB_SEED_DISABLED=false
DB_SEED_FORCE=false

# --- Paths ---
UPLOADS_DIR=./uploads
LOGS_DIR=./logs

# --- Cloudflare (referencia — cloudflared corre en el host, no en Docker) ---
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_TUNNEL_NAME=mi-tunnel-api
